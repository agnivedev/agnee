PORT=4100
HOST=0.0.0.0
API_KEY=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret
ADMIN_EMAIL=admin@agnee.local
ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL. Compose uses POSTGRES_PASSWORD; direct local Node can use DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Persist this directory as a Docker volume.
WA_SESSION_PATH=/data/whatsapp
PLAYBOOK_STORAGE_PATH=/data/playbooks
WA_CLIENT_ID=agnee-main
WA_DEFAULT_COUNTRY_CODE=62
WA_STARTUP_ENABLED=true
WA_DEMO_MODE=false

# Remote MCP service. Reverse proxy mcp.agnee.agnive.co to port 4200.
MCP_PORT=4200
MCP_HOST=0.0.0.0
MCP_BEARER_TOKEN=replace-with-a-third-long-random-secret
MCP_PUBLIC_URL=https://mcp.agnee.agnive.co/mcp
MCP_OAUTH_SIGNING_SECRET=replace-with-a-fourth-long-random-secret
MCP_OAUTH_STATE_PATH=/data/mcp/oauth.json
MCP_RATE_LIMIT_PER_MINUTE=180

# Optional: Agnee backend endpoint receiving inbound WhatsApp messages.
INBOUND_WEBHOOK_URL=
INBOUND_WEBHOOK_SECRET=

# Optional prototype acknowledgement. Keep false when the LLM reply loop is ready.
WA_ACK_ENABLED=false
WA_ACK_TEXT=Terima kasih, pesan Anda sudah kami terima.

# LLM & Auto-reply (optional, disabled if not set)
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
LLM_CONTEXT_WINDOW=8000
LLM_MAX_TOKENS=512
KNOWLEDGE_CLIENT=bzone

# Reverse proxy trust. Leaving this unset is now SAFE: the default allowlist is
# 127.0.0.1,::1,172.16.0.0/12 (loopback + the Docker bridge), so the real client
# IP is read from X-Forwarded-For only when the request actually arrives from
# one of those addresses. This used to default to "off", and production ran that
# way — every user shared one rate-limit bucket (the proxy's IP), so ten failed
# logins from anyone locked out every tenant for 15 minutes.
# Set this only to name a different proxy network:
#   10.0.0.0/8,...  comma-separated allowlist of proxy IPs/CIDRs — the form to use
#   true            trusts the WHOLE X-Forwarded-For chain; clients can then spoof
#                   their IP and bypass rate limits entirely. Logged as a warning.
#   1 / 2           hop counts do NOT yield the client IP on Fastify 5 (measured:
#                   request.ip stays the proxy's). Logged as a warning.
TRUST_PROXY=

# Company (id or slug) the MCP server acts for. Required — there is no default tenant.
AGNEE_COMPANY=agnive

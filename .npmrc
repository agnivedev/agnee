# Advisory 1139346: extract-zip symlink path traversal via @puppeteer/browsers.
# Not exploitable here — puppeteer uses a pre-installed system chromium
# (PUPPETEER_EXECUTABLE_PATH / executablePath in whatsapp-manager.js) and
# never calls the browser-download code path that uses extract-zip.
# Downgrading to whatsapp-web.js@1.34.2 (the suggested fix) would regress
# to an older release; we stay on 1.34.7 and accept this advisory.
audit-level=critical
